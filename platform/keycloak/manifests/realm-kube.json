{
  "realm": "kube",
  "displayName": "Kube groupe 12",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "groups": [
    {
      "name": "kube-admins",
      "attributes": { "description": ["Administration complète du cluster et des outils (cluster-admin)"] }
    },
    {
      "name": "kube-devs",
      "attributes": { "description": ["Déploiement et modification des applications (edit)"] }
    },
    {
      "name": "kube-viewers",
      "attributes": { "description": ["Lecture seule (view)"] }
    }
  ],
  "users": [
