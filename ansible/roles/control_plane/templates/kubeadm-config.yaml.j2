# Généré par Ansible (rôle control_plane)
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ private_ip }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  # kube-1 est aussi worker : pas de taint control-plane
  taints: []
  kubeletExtraArgs:
    - name: node-labels
      value: "{{ node_label_key }}={{ inventory_hostname }}"
    - name: node-ip
      value: "{{ private_ip }}"
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ kubernetes_release }}
clusterName: kube-12
controlPlaneEndpoint: "{{ private_ip }}:6443"
networking:
  podSubnet: {{ pod_cidr }}
apiServer:
  certSANs:
    - {{ private_ip }}
    - {{ public_ip }}
    - {{ inventory_hostname }}
{% if control_plane_oidc_issuer_url %}
  extraArgs:
    - name: oidc-issuer-url
      value: "{{ control_plane_oidc_issuer_url }}"
    - name: oidc-client-id
      value: "{{ control_plane_oidc_client_id }}"
    - name: oidc-username-claim
      value: "{{ control_plane_oidc_username_claim }}"
    - name: oidc-groups-claim
      value: "{{ control_plane_oidc_groups_claim }}"
{% endif %}
# Métriques lues par Prometheus (#45, docs/monitoring.md § 3) : écoute sur toutes les
# interfaces au lieu de 127.0.0.1. Ports ouverts entre nœuds seulement (security group).
controllerManager:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
scheduler:
  extraArgs:
    - name: bind-address
      value: "0.0.0.0"
etcd:
  local:
    extraArgs:
      - name: listen-metrics-urls
        value: "http://0.0.0.0:2381"
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
metricsBindAddress: "0.0.0.0:10249"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
