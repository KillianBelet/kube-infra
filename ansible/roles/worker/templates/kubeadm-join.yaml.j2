# Généré par Ansible (rôle worker)
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ hostvars[cp].private_ip }}:6443"
    token: "{{ hostvars[cp].control_plane_join_token }}"
    caCertHashes:
      - "{{ hostvars[cp].control_plane_join_ca_hash }}"
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-labels
      value: "{{ node_label_key }}={{ inventory_hostname }}"
    - name: node-ip
      value: "{{ private_ip }}"
